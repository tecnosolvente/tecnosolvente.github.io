---
/**
 * Propuesta de valor: 3 tarjetas con ícono, título y descripción.
 * Los íconos son SVG inline (trazos estilo "outline") para no sumar dependencias.
 */
import { getLang, t } from '../i18n/utils';
const tr = t(getLang(Astro.url));

// Íconos (SVG path, estilo outline): ondas NFC, ventana de navegador, escudo con check.
const icons = [
  'M8.5 8.5a5 5 0 0 1 0 7M5.5 5.5a9.24 9.24 0 0 1 0 13M12 12h.01M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9.24 9.24 0 0 1 0 13',
  'M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6ZM3 9h18M7 6.5h.01M10 6.5h.01',
  'M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3ZM9 12l2 2 4-4',
];
const items = tr.value.items.map((item, i) => ({ ...item, icon: icons[i] }));
---

<section id="servicios" class="border-t border-white/5 bg-ink-900/60 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{tr.value.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{tr.value.title}</h2>
      <p class="mt-4 text-slate-400">
        {tr.value.text}
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        items.map((item) => (
          <article class="rounded-3xl border border-white/10 bg-ink-800/50 p-8">
            <div class="grid size-12 place-items-center rounded-2xl bg-brand-500/10 text-brand-400 ring-1 ring-brand-400/20">
              <svg
                class="size-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={item.icon} />
              </svg>
            </div>
            <h3 class="mt-6 text-xl font-semibold">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-slate-400">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
