---
/**
 * Navbar fija con efecto "glass". En mobile muestra logo + selector de idioma + CTA compacto;
 * en desktop suma los links de navegación.
 */
import { SITE, whatsappLink } from '../config/site';
import { getLang, t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const tr = t(getLang(Astro.url));

const links = [
  { href: '#servicios', label: tr.nav.services },
  { href: '#planes', label: tr.nav.plans },
  { href: '#contacto', label: tr.nav.contact },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-ink-950/75 backdrop-blur-xl">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6"
    aria-label={tr.nav.label}
  >
    <!-- Logo -->
    <a href="#inicio" class="flex min-h-11 min-w-0 items-center gap-3">
      <span
        class="grid size-9 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-brand-400 to-brand-600 font-display text-lg font-bold text-ink-950"
        aria-hidden="true">TS</span
      >
      <span class="min-w-0 leading-tight">
        <span class="block truncate font-display text-base font-bold text-white">{SITE.name}</span>
        <span class="hidden text-xs whitespace-nowrap text-slate-400 xl:block">{tr.tagline}</span>
      </span>
    </a>

    <!-- Links (solo desktop; en mobile/tablet alcanza con el scroll y el CTA) -->
    <ul class="hidden items-center gap-6 text-sm font-medium lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="inline-block px-1 py-3 text-slate-300 transition hover:text-white">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <LanguageSwitcher />

      <!-- CTA WhatsApp -->
      <a
        href={whatsappLink(tr.wa.general)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary min-h-11 min-w-11 shrink-0 px-3 py-2 text-sm whitespace-nowrap min-[420px]:px-4"
        aria-label={tr.nav.ctaLong}
      >
        <!-- Celulares chicos (<420px): solo el ícono, para que entren logo + idioma + WhatsApp -->
        <WhatsAppIcon class="size-5 min-[420px]:size-4" />
        <span class="hidden lg:inline">{tr.nav.ctaLong}</span>
        <span class="hidden min-[420px]:inline lg:hidden">{tr.nav.ctaShort}</span>
      </a>
    </div>
  </nav>
</header>
