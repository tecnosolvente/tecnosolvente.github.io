---
/**
 * Listado oficial de servicios y precios.
 * Grilla responsiva: 1 columna en mobile, 2 en tablet/notebook, 4 desde 1280px.
 */
import { MONTHLY_CHANGES, PLANS } from '../config/site';
import { getLang, t } from '../i18n/utils';
import PlanCard from './PlanCard.astro';

const tr = t(getLang(Astro.url));
---

<section id="planes" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{tr.pricing.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{tr.pricing.title}</h2>
      <p class="mt-4 text-slate-400">
        {tr.pricing.text(MONTHLY_CHANGES)}
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {PLANS.filter((plan) => !plan.hidden).map((plan) => <PlanCard plan={plan} />)}
    </div>

    <p class="mt-10 text-center text-sm text-slate-400">
      {tr.pricing.currencyNote}
    </p>
  </div>
</section>
